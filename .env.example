# Copy to .env. EVERYTHING HERE IS OPTIONAL.
#
# NOT USED ON DATABRICKS APPS. A deployed app takes its settings from
# `app.yaml` and its secrets from the secret scope, and this file is never
# uploaded. It is for running the service on your own machine.
#
# An install configured through /setup in the browser needs none of this file —
# the settings are stored encrypted in the database, with the key in a 0600 file
# outside it. This is for a deployment whose configuration is managed somewhere
# else: Ansible, a systemd EnvironmentFile, a container's environment.
#
# THE ORDER OF PRECEDENCE IS STRICT, and the pages say so rather than accepting
# an edit that will not take effect:
#
#     the environment  >  the stored settings  >  the built-in defaults
#
# So anything you set here can no longer be changed from the browser. That is
# the point of setting it here.


# ── Where it listens ────────────────────────────────────────────────────────
#
# LOOPBACK BY DEFAULT, and that is a security control rather than a default
# nobody changed. Put a reverse proxy in front of it (deploy/nginx.conf.sample)
# rather than binding this to the world.
# POLICY_PORT=5290
# POLICY_HOST=127.0.0.1

# The public name, if it has one. Used to refuse a "source" that points back at
# this service — a provenance chain that leaves the paper and comes back is not
# evidence.
# POLICY_HOSTNAME=policy.example.gov.uk


# ── Who can get in ──────────────────────────────────────────────────────────
#
# THE ADMIN PASSWORD, which opens /setup and /admin. Setting it here pins it:
# the panel can no longer change it, and this is the recovery path if the
# stored one is lost.
#
# Leave it unset on a fresh install and the service accepts `admin` / `admin`
# ONCE, to replace it — but only while it is bound to loopback, or while
# POLICY_SETUP_TOKEN below is set and presented.
# POLICY_ADMIN_PASSWORD=

# REQUIRED TO SET UP AN INSTALL THAT IS NOT ON LOOPBACK. Anything you choose.
# Without it, a service reachable from outside refuses the shipped credential
# entirely — so it cannot be claimed by whoever finds it first.
# POLICY_SETUP_TOKEN=

# WHO MAY READ THE ASSESSMENTS, as opposed to who may configure them.
# `open` (the default) or `password`. A reader who can open an assessment must
# not thereby hold the key to your model credentials, so this is a SEPARATE
# password from the admin one.
# POLICY_ACCESS=open
# POLICY_READER_PASSWORD=

# 1 makes every mutation a 403. Existing assessments still open and export.
# POLICY_READ_ONLY=0


# ── Which service answers ───────────────────────────────────────────────────
#
# Configure ONE of these blocks, or configure none and use /setup.

# NARROW WHAT THIS BUILD OFFERS, without a rebuild. This is how you ship it
# without the OpenAI-compatible/Codex entry, which is a local bridge and no use
# to anybody else.
# POLICY_PROVIDERS=openrouter,azure
# POLICY_PROVIDER=azure

# --- Azure AI Foundry -------------------------------------------------------
# The endpoint is the resource root; anything after the host is trimmed, so a
# URL copied from the portal works as pasted. The DEPLOYMENT NAME is what every
# request asks for and what the assessment records as the model it used.
# AZURE_FOUNDRY_ENDPOINT=https://my-resource.openai.azure.com
# AZURE_FOUNDRY_DEPLOYMENT=gpt-5-policy
# AZURE_FOUNDRY_API_VERSION=2024-10-21
#
# key | entra-app | managed-identity | workload-identity
# A resource with local authentication switched off has no key; use Entra.
# AZURE_AUTH_MODE=key
# AZURE_FOUNDRY_KEY=
#
# For entra-app and workload-identity:
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_FEDERATED_TOKEN_FILE=/var/run/secrets/azure/tokens/azure-identity-token
# AZURE_AUTHORITY_HOST=https://login.microsoftonline.com

# --- OpenRouter -------------------------------------------------------------
# One key, billed per token, reaching every model in the picker.
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- Anything else that speaks the OpenAI API -------------------------------
# A local Ollama or vLLM, a gateway of your own, an APIM front end.
# It must be reachable from the machine running THIS service, not from yours.
# CODEX_BASE_URL=http://127.0.0.1:11434/v1
# CODEX_MODEL=
# CODEX_API_KEY=

# --- Databricks Model Serving ------------------------------------------------
# A Foundation Model API or external model endpoint, behind AI Gateway. Inside
# Databricks Apps the host and the service principal's credentials are
# injected, and only the endpoint name needs setting. From a laptop, use a
# personal access token.
# POLICY_DATABRICKS_ENDPOINT=databricks-claude-sonnet-5
# DATABRICKS_HOST=https://my-workspace.cloud.databricks.com
# POLICY_DATABRICKS_AUTH=token
# DATABRICKS_TOKEN=

# Claude prompt caching through Model Serving, as an experiment. 1 to try it.
# POLICY_DATABRICKS_PROMPT_CACHE=0

# ── How much runs at once ───────────────────────────────────────────────────
#
# Documents in progress together (1 to 6, default 2). Each run's parallel
# calls are chosen per submission on the form.
# POLICY_WORKERS=2
#
# How long a stop waits for the stage in flight before handing it back to the
# queue. Unlimited by default; 10 seconds inside Databricks Apps, which kills a
# stopping process at 15.
# POLICY_STOP_GRACE_MS=

# The default model, and what the picker offers. A provider that serves exactly
# one model (an Azure deployment) decides this for itself.
# POLICY_RESEARCH_MODEL=
# POLICY_MODELS=


# ── Looking things up ───────────────────────────────────────────────────────
#
# One of the eighteen stages checks claims against the outside world.
#
# auto | tavily | grounded | none
#
# `none` IS A REAL ANSWER and the right one for a network with no route out:
# the run skips the asking rather than failing at it, and the report says every
# finding rests on the paper. Without this it discovers the same thing once per
# question, at the cost of a model call each time.
# POLICY_SEARCH=auto
# TAVILY_API_KEY=


# ── Where the data lives ────────────────────────────────────────────────────
#
# THREE THINGS WITH THREE DIFFERENT BACKUP RULES — see the README.
# The key directory holds `settings.key`, which decrypts every stored
# credential, AND the per-run sealing keys. A LOST SEALING KEY IS A SHREDDED
# RUN, by design.
# POLICY_DATA_DIR=.data/db
# POLICY_SEAL_KEY_DIR=data/policy-keys

# Assessments are scoped to an owner because the column is NOT NULL and the
# store filters on it — not because anything is being kept out.
# POLICY_OWNER_EMAIL=you@example.com

# What an offline pack says produced it.
# POLICY_PRODUCER=Policy Red Team


# ── A network you do not control ────────────────────────────────────────────
#
# Node reads these itself, before any of this application runs.
#
# Include 127.0.0.1 and localhost in NO_PROXY if anything is configured on
# loopback: a local endpoint sent to a corporate proxy never answers, and the
# error reads as "unreachable" either way.
# HTTPS_PROXY=http://proxy.internal:8080
# NO_PROXY=127.0.0.1,localhost,.internal
#
# For a TLS-inspecting middlebox. Node says NOTHING if the path is wrong; the
# first symptom is every handshake failing. `npm run doctor` checks it.
# NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/inspection.crt
